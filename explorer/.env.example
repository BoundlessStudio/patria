# Optional origin for a self-hosted Photon geocoder. Defaults to https://photon.komoot.io.
PATRIA_PHOTON_URL=
# Optional OSRM foot router base URL. Defaults to https://routing.openstreetmap.de/routed-foot/.
PATRIA_WALK_ROUTER_URL=
# Google Maps JavaScript browser key restricted to this application's origins.
GOOGLE_MAPS_BROWSER_KEY=
# Optional override for the Patria vector map's cloud style.
GOOGLE_MAPS_MAP_ID=e873743a69b2532eefe6dd55
# Optional key for the local Marble generation command.
WLT_API_KEY=
